# Copy only the relevant block to a local .env and run: chmod 600 .env

# Common settings
RUNNER_PROVIDER=github
# RUNNER_NAME is randomly chosen once as cakecat-<cake> when omitted.
# RUNNER_NAME=cakecat-tiramisu
# RUNNER_USER=runner
# RUNNER_PASSWORDLESS_SUDO=0
# HOST_SWAP_SIZE=0

# GitHub organization runner
GH_TOKEN=github_pat_replace_me
ORG=replace_me
RUNNER_GROUP=Default
GITHUB_LABELS=cakecat,potato,mikrus

# Forgejo alternative (comment the GitHub block and uncomment these)
# RUNNER_PROVIDER=forgejo
# FORGEJO_URL=https://git.example.com
# FORGEJO_API_TOKEN=replace_me
# FORGEJO_SCOPE=org:replace_me
# FORGEJO_LABELS=docker:docker://node:20-bookworm
# FORGEJO_RUNNER_VERSION=latest
