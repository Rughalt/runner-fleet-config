# Copy to .env, replace secrets, run: chmod 600 .env

# GitHub / Seele + Warp Trotters
RUNNER_PROVIDER=github
GH_TOKEN=github_pat_replace_me
ORG=Dragonshorn-Studios
RUNNER_GROUP=Default
RUNNER_COUNT=2
RUNNER_PREFIX=selee-trotter

# Forgejo / Lux + Poros (uncomment this block instead of the GitHub block)
# RUNNER_PROVIDER=forgejo
# FORGEJO_URL=https://git.example.com
# FORGEJO_API_TOKEN=replace_me
# FORGEJO_SCOPE=org:my-organization
# FORGEJO_RUNNER_COUNT=2
# FORGEJO_RUNNER_PREFIX=lux-poro
# FORGEJO_LABELS=docker:docker://node:20-bookworm
# FORGEJO_RUNNER_VERSION=13.1.0

VM_CPUS=2
VM_MEMORY=1536MiB
VM_DISK=15GiB
HOST_SWAP_SIZE=2G
GUEST_SWAP_SIZE=1G
DAILY_CLEANUP=1
